# Copy to .env.local (local) or set in your host's environment settings.
# Both are read on the server only. Do NOT prefix them with NEXT_PUBLIC_.

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the publishable key (sb_publishable_...). Never put the secret/service_role key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
